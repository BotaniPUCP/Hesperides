{
  "name": "hesperides-video-flujos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Video de los flujos de Hesperides para el cliente, presentado por Hespo.",
  "scripts": {
    "estudio": "remotion studio src/index.ts",
    "prueba": "vitest run",
    "tipos": "tsc --noEmit",
    "render": "remotion render src/index.ts VideoFlujos out/hespo-flujos.mp4 --codec=h264",
    "render:planificacion": "remotion render src/index.ts VideoPlanificacion out/hespo-planificacion.mp4 --codec=h264",
    "render:venta": "remotion render src/index.ts VideoVenta out/hespo-venta.mp4 --codec=h264 --gl=angle",
    "fotogramas": "tsx scripts/fotogramas.ts",
    "duracion": "tsx scripts/duracion.ts",
    "capturas": "tsx scripts/capturas.ts",
    "capturas:planificacion": "tsx scripts/capturas-planificacion.ts",
    "capturas:venta": "tsx scripts/capturas-venta.ts",
    "revisar": "tsx scripts/revisar.ts",
    "fondos": "tsx scripts/fondos.ts",
    "efectos": "python scripts/generar_efectos.py"
  },
  "dependencies": {
    "@react-three/fiber": "9.1.2",
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/google-fonts": "4.0.540",
    "@remotion/media-utils": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@remotion/three": "4.0.540",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.540",
    "three": "0.171.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.1.12",
    "@types/three": "0.171.0",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.5.4",
    "vitest": "3.2.7"
  }
}
