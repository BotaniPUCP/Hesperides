        }
      ]
    },
    {
      "id": "lucia",
      "frases": [
        {
          "id": "q4",
          "texto": "Ella es Lucía.",
          "hespo": {
            "x": -220,
            "pose": "quieto"
          },
          "respiro": 0.2
        },
        {
          "id": "q5",
