            "x": 300,
            "pose": "senala"
          }
        },
        {
          "id": "c3",
          "texto": "El conjunto, dónde.",
          "hespo": {
            "x": 740,
            "pose": "senala"
          }
        },
        {
          "id": "c4",
          "texto": "La planificación, qué toca.",
          "hespo": {
            "x": 1180,
            "pose": "senala"
          }
        },
        {
          "id": "c5",
          "texto": "Y la reserva, cuándo no molestar.",
          "hespo": {
            "x": 1620,
            "pose": "senala"
          }
        },
        {
          "id": "c6",
          "texto": "¡Gracias por acompañarme! Nos vemos en el campus.",
          "hespo": {
            "x": 2120,
            "pose": "saluda",
            "espera": 0.6
          }
        }
      ]
    }
  ]
}
