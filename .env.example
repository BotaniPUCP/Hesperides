# Plantilla de variables de entorno. Copiala a .env y rellena los campos
# vacios; los que traen valor funcionan tal cual en desarrollo local.
#
#   cp .env.example .env
#
# Vacio significa que no hay default razonable: o es un secreto, o su valor
# cambia en cada entorno. El backend no arranca si falta alguno de los
# obligatorios, en vez de continuar con un valor de relleno.
#
# .env NUNCA se versiona. Este archivo si, asi que no escribas secretos aqui.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=hesperides
POSTGRES_USER=hesperides
# Obligatoria. En local cualquier valor sirve; fuera de local, una clave
# generada y distinta por entorno.
POSTGRES_PASSWORD=
# Puerto en el host para inspeccionar la BD con DBeaver o psql. Solo lo publica
# docker-compose.dev.yml: en el compose base la BD no sale de la red interna.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Backend (Spring Boot)
# ---------------------------------------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# Host y puerto de la BD vistos desde el backend. `db` es el nombre del
# servicio en la red de compose, no una maquina del host.
DB_HOST=db
DB_PORT=5432

# Clave de firma JWT: minimo 32 caracteres (HS256). Obligatoria y distinta por
# entorno. Generar con: openssl rand -base64 48
JWT_SECRET=
# En produccion debe ser true: sin HTTPS local el navegador descarta la cookie.
COOKIE_SECURE=false
# Origenes que pueden llamar a la API desde un navegador, separados por comas.
# Obligatoria porque depende del dominio del frontend en cada entorno. Nunca un
# comodin: con cookies de sesion el navegador rechaza esa combinacion.
# En local: http://localhost:3000
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# SMTP - entrega de credenciales (SPEC-100)
# ---------------------------------------------------------------------------
# Unica dependencia externa admitida del proyecto (SPEC-000 §1): su caida nunca
# impide un alta, la cuenta queda en PENDING_DELIVERY y el administrador
# reenvia.
#
# El proyecto usa el relay SMTP de Brevo. Se eligio SMTP y no su API REST porque
# asi el backend no depende de ningun SDK ni de la forma de la API de un
# proveedor: cambiar de proveedor es cambiar estas variables, no codigo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
# Credenciales en Brevo > SMTP & API > SMTP. El usuario es un correo y la clave
# es la "SMTP key", NO la contrasena de la cuenta ni la API key.
SMTP_USERNAME=
SMTP_PASSWORD=
# Remitente, obligatorio y verificado en Brevo > Senders. Un dominio que no
# existe NO da error: Brevo responde 250 "queued", el backend marca DELIVERED y
# el correo se descarta despues en silencio. En desarrollo usa tu propio correo,
# que Brevo verifica solo al registrarte. Produccion exige un dominio real con
# SPF y DKIM.
SMTP_FROM=
# URL publica del frontend para el enlace del correo. Nunca se deduce del header
# Host de la peticion: quien lo controle apuntaria el correo a su dominio.
#
# Obligatoria y sin default a proposito: su valor cambia en cada entorno y un
# default de desarrollo acabaria invitando a entrar en localhost a quien recibe
# el correo, que no significa nada fuera de su maquina. Siempre https y sin
# barra final, porque va tal cual en el enlace.
APP_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
# Se inlinea en el bundle del cliente durante `npm run build`, no se lee en
# tiempo de ejecucion: cambiarla exige reconstruir la imagen del frontend.
# Obligatoria porque es el dominio publico del backend en cada entorno.
# En local: http://localhost:8080/api/v1
NEXT_PUBLIC_API_URL=

# ---------------------------------------------------------------------------
# Data service (Flask)
# ---------------------------------------------------------------------------
DATA_SERVICE_PORT=5001
# URL del servicio dentro de la red de compose, para cuando el backend lo llame.
DATA_SERVICE_URL=http://data-service:5001
