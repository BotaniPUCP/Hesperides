# PostgreSQL
POSTGRES_DB=hesperides
POSTGRES_USER=hesperides
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_PORT=5432

# Backend (Spring Boot)
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
DB_HOST=db
DB_PORT=5432

# Clave de firma JWT: minimo 32 caracteres (HS256). Generar una distinta por
# entorno con: openssl rand -base64 48
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria_de_al_menos_32_chars
# En produccion debe ser true: sin HTTPS local el navegador descarta la cookie.
COOKIE_SECURE=false
# Origenes que pueden llamar a la API desde un navegador, separados por comas.
# Nunca un comodin: con cookies de sesion el navegador rechaza esa combinacion.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SMTP para la entrega de credenciales (SPEC-100). Unica dependencia externa
# admitida del proyecto (SPEC-000 §1): su caida nunca impide un alta, la cuenta
# queda en PENDING_DELIVERY y el administrador reenvia.
#
# El proyecto usa el relay SMTP de Brevo. Se eligio SMTP y no su API REST porque
# asi el backend no depende de ningun SDK ni de la forma de la API de un
# proveedor: cambiar de proveedor es cambiar estas cuatro variables, no codigo.
# Las credenciales estan en Brevo > SMTP & API > SMTP (el login es un correo y
# la clave es la "SMTP key", NO la contrasena de la cuenta ni la API key).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# El remitente debe estar verificado en Brevo > Senders, o el envio se rechaza.
SMTP_FROM=no-reply@hesperides.pucp.edu.pe
# URL publica del frontend para el enlace del correo. Nunca se deduce del header
# Host de la peticion: quien lo controle apuntaria el correo a su dominio.
APP_PUBLIC_URL=http://localhost:3000

# Frontend (Next.js)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Data service (Flask)
DATA_SERVICE_PORT=5001
DATA_SERVICE_URL=http://data-service:5001
